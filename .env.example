# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=records

# --- Shared DB connection (consumed by api-service + worker-service) ---
# DB_HOST is the compose service name; leave as 'postgres' for local dev.
DB_HOST=postgres
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=records

# --- Service tunables ---
LOG_LEVEL=info
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
WORK_SIMULATION_MS=2000
